ENV=development

# Supabase session pooler (port 5432 — supports asyncpg prepared statements;
# do NOT use the transaction pooler on 6543).
# Runtime URL (async driver):
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Same database, sync driver — used only by Alembic migrations:
DATABASE_URL_SYNC=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Requires the postgis extension: CREATE EXTENSION postgis;

# Supabase project URL — used to verify auth JWTs against its JWKS endpoint
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key — used for admin-level auth operations (account deletion).
# Keep this server-side only, never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=http://localhost:3000

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=you@example.com

# S3-compatible object storage for photos (AWS S3, or self-hosted MinIO)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=media
S3_REGION=us-east-1
STORAGE_PUBLIC_URL=

# --- Chat assistant (per-circuit "Astra") — optional, off by default ---
ASSISTANT_ENABLED=false
# "claude" (Claude Code CLI subscription login — run `claude auth login` on
# this machine, no API key needed) or "gemini". The other is the automatic
# fallback. See app/config.py for model/rate-limit overrides.
ASSISTANT_PRIMARY=claude
# Gemini API key — required if ASSISTANT_PRIMARY=gemini, and used as the
# fallback either way. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — Stadia Maps API key for better place-search quality (free tier
# at https://stadiamaps.com). Falls back to free Nominatim search if unset.
STADIA_API_KEY=
