# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8001

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Map tiles — path to a MapLibre style JSON. Defaults to the bundled
# /map-style-satellite.json (ESRI satellite imagery) if unset.
NEXT_PUBLIC_MAP_STYLE=/map-style-satellite.json

# Unsplash — fallback cover images for circuits/points without photos.
# Get a free key at https://unsplash.com/developers
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# Chat assistant ("Astra") — must match the backend's ASSISTANT_ENABLED.
NEXT_PUBLIC_ASSISTANT_ENABLED=false
